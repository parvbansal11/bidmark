# Database (SQLite for development; any SQLAlchemy URL works, e.g. postgresql://user:pass@host/bidmark)
DATABASE_URL=sqlite:///./bidmark.db

# Auth
JWT_SECRET=change-this-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
# Staff self-registration (Admin, Officer, Auditor) is allowed only for emails on this domain.
# Format check only. Leave EMPTY in production: staff accounts are then issued by an Admin.
PRIVILEGED_ROLE_EMAIL_DOMAIN=cpcl.gov.in

# Files
UPLOAD_DIRECTORY=./uploads
MAX_UPLOAD_SIZE_MB=15
# PEM roots trusted for PDF signatures (CCA India root in production; the seed adds its demo CA here)
TRUST_ROOTS_DIR=./trust-roots
DEMO_CA_DIR=./demo-ca
# Fill fields from the bidder profile when a file has no readable text (marked simulated). false in production.
SIMULATE_UNREADABLE_DOCUMENTS=true

# Government registries: sandbox dataset first, then the seeded mock gateway
MOCK_GOVERNMENT_API=true
SANDBOX_REGISTRY_PATH=./data/sandbox_registry.json

# Copilot ("Ask Bidmark"). Optional: verification, findings and decisions never depend on it.
#   mock: answers are composed from recorded findings by fixed templates, no language model.
#   llm:  answers are written by Claude from the same recorded findings, with citations.
#         If the model cannot answer (no key, timeout, API error), the assistant reports
#         itself unavailable. It never substitutes a templated answer.
AI_PROVIDER=mock
# Anthropic API key. Leave empty to use ANTHROPIC_API_KEY or an `ant auth login` profile.
# Server side only: never expose it to the frontend.
LLM_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_TIMEOUT_SECONDS=30

# Exact web origins allowed to call the API (comma separated). No wildcards.
CORS_ORIGINS=http://localhost:5173
ENVIRONMENT=development
APP_NAME=Bidmark

# Rebuild the seeded dataset on every container start (Docker/Render only)
SEED_ON_BOOT=false
