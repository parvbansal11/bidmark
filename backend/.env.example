# Database
DATABASE_URL=sqlite:///./gem_compliance.db
# For PostgreSQL-compatible deployment, use e.g.:
# DATABASE_URL=postgresql://user:password@localhost:5432/gem_compliance

# Security
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# DEMO-ONLY: public self-registration may create an Admin or Procurement
# Officer account (in addition to Bidder, which is unrestricted) only when
# the email ends with this domain. Format check only — no mailbox/DNS
# verification. Change or remove for a real deployment.
PRIVILEGED_ROLE_EMAIL_DOMAIN=cpcl.gov.in

# File storage
UPLOAD_DIRECTORY=./uploads
MAX_UPLOAD_SIZE_MB=15

# Mock Government API Gateway
MOCK_GOVERNMENT_API=true

# AI Provider: "mock" (default, deterministic, no external calls) or "llm"
AI_PROVIDER=mock
LLM_API_KEY=

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# App
ENVIRONMENT=development
APP_NAME=GeM Bid Compliance Verification Platform
